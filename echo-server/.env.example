# Per-service database URLs, read by drizzle-kit migrations (each service's
# drizzle.config.ts loads this root .env). Host port 15432 maps to the
# dockerized Postgres — 5432 on this machine belongs to a native install.
AUTH_DATABASE_URL=postgresql://echo:echo_dev@localhost:15432/echo_auth
USERS_DATABASE_URL=postgresql://echo:echo_dev@localhost:15432/echo_users
CHATS_DATABASE_URL=postgresql://echo:echo_dev@localhost:15432/echo_chats
FRIENDS_DATABASE_URL=postgresql://echo:echo_dev@localhost:15432/echo_friends
BLOB_DATABASE_URL=postgresql://echo:echo_dev@localhost:15432/echo_blobs
GROUPS_DATABASE_URL=postgresql://echo:echo_dev@localhost:15432/echo_groups
VOICE_DATABASE_URL=postgresql://echo:echo_dev@localhost:15432/echo_voice

JWT_SECRET=dev-secret-change-in-production
INTERNAL_API_KEY=dev-internal-key
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# voice-service -> LiveKit from docker compose (LIVEKIT_KEYS in docker-compose.yml).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_in_production_min_32_chars_long

# pers-chats-service — at-rest message encryption key (base64-encoded 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Either "<base64>" (implicit key_id 1) or "1:<b64>,2:<b64>" for rotation.
# Losing this key means losing all encrypted message data — back it up.
MESSAGE_ENCRYPTION_KEY=
# Optional override — defaults to the highest key_id present in MESSAGE_ENCRYPTION_KEY.
MESSAGE_ENCRYPTION_CURRENT_KEY_ID=

# blob-service storage. "local" writes to uploads/blobs on disk (default);
# "s3" targets any S3-compatible store. Dev uses the MinIO container from
# docker-compose; for prod point S3_* at Cloudflare R2 / Backblaze B2.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=echo-blobs
S3_ACCESS_KEY=echo
S3_SECRET_KEY=echo_dev_secret
# Path-style URLs (endpoint/bucket/key) — required by MinIO, fine for R2/B2.
S3_FORCE_PATH_STYLE=true
