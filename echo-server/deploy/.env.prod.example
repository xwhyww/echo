# Copy to deploy/.env on the server and fill in. Never commit the filled copy —
# it holds every secret the stack has.
#
# Generate the random values with:
#   JWT_SECRET / INTERNAL_API_KEY / POSTGRES_PASSWORD / LIVEKIT_API_SECRET
#     openssl rand -base64 36
#   MESSAGE_ENCRYPTION_KEY (must be exactly 32 bytes, base64)
#     openssl rand -base64 32

# --- Domains -----------------------------------------------------------------
# Each needs an A record pointing at this server before the first `up`, or
# Caddy's certificate request fails.
# app: the web client, served by Caddy from ./client-dist (see README).
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
WS_DOMAIN=ws.example.com
LIVE_DOMAIN=live.example.com
ACME_EMAIL=you@example.com

# Exact origins the web client is served from, comma-separated. No wildcards:
# these are sent credentials.
ALLOWED_ORIGINS=https://app.example.com

# --- Secrets -----------------------------------------------------------------
JWT_SECRET=
INTERNAL_API_KEY=
POSTGRES_USER=echo
POSTGRES_PASSWORD=

# At-rest message encryption for pers-chats-service. Losing this key means
# losing every stored message — back it up off this server. Either "<base64>"
# (implicit key_id 1) or "1:<b64>,2:<b64>" for rotation.
MESSAGE_ENCRYPTION_KEY=

# --- Test sign-in accounts ---------------------------------------------------
# Nine fixed numbers (+71111111111 … +79999999999) that sign in with a fixed
# code and never reach an SMS provider. They exist because App Store and Play
# Store reviewers cannot receive an SMS on a Russian number, and because
# end-to-end tests need an account they can drive.
#
# In production the code has NO default. Leave AUTH_TEST_CODE unset and test
# sign-in stays off — which is the right state until a store actually needs it.
# Setting it opens nine accounts to anyone who guesses the number and the code,
# so pick something non-obvious, never give those accounts a password, and treat
# anything inside them as public.
AUTH_TEST_CODE=
# Set to false to switch the mechanism off outright.
AUTH_TEST_ENABLED=true
# Comma-separated override of the number list. Unset means the nine defaults.
AUTH_TEST_PHONES=

# --- Push notifications ------------------------------------------------------
# Both providers are optional and independent. With neither set, push-service
# still registers devices and logs what it would have sent.
#
# Android (Firebase Cloud Messaging). Download the service-account JSON from the
# Firebase console — Project settings → Service accounts → Generate new private
# key — and put it in deploy/fcm/ on the server. The path here is the one inside
# the container; deploy/fcm is mounted read-only at /run/secrets/fcm.
FCM_SERVICE_ACCOUNT_PATH=
# e.g. /run/secrets/fcm/echo-firebase-adminsdk.json

# iOS (APNs). Needs a paid Apple Developer membership; leave unset until then.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# Whether a banner may quote the message. Off is the safer default — messages
# are encrypted at rest and a preview hands their plaintext to Apple and Google.
# Each user can override this for their own account in the app.
PUSH_MESSAGE_PREVIEW=false

# --- Rate limiting ------------------------------------------------------------
# Both are per client address, enforced by the gateway, and both are optional —
# the defaults below apply when unset.
#
# How many POST /auth/otp/request calls one address may make per 15 minutes.
# Each one can put a paid SMS on the wire. auth-service separately holds a
# 60-second cooldown per phone number, but that does nothing against a caller
# walking through many numbers, which is what this stops. Raise it if real users
# start hitting it: Russian mobile carriers put many subscribers behind one
# CGNAT address, so the bucket is shared by more people than it looks.
RATE_LIMIT_OTP_REQUESTS=10
# Catch-all ceiling per minute for everything else.
RATE_LIMIT_GLOBAL_PER_MINUTE=600

# --- LiveKit (voice) ---------------------------------------------------------
LIVEKIT_API_KEY=echo
LIVEKIT_API_SECRET=

# --- Object storage: Yandex Object Storage -----------------------------------
# Create the bucket and a service account with storage.editor first; the key
# pair below is that account's static access key. The service does not create
# the bucket in production — it has no right to.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=echo-blobs
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Yandex serves virtual-host style; path-style is a MinIO-only requirement.
S3_FORCE_PATH_STYLE=false

# --- SMS ---------------------------------------------------------------------
# log      — writes sign-in codes to the service log (start here, then move off)
# telegram — Telegram Gateway; cheap, no sender registration, Telegram users only
# smsc     — SMSC.ru; reaches everyone, needs a contract and a registered sender
#
# The intended production pairing is telegram with smsc as the fallback.
SMS_DRIVER=log
SMS_FALLBACK_DRIVER=
SMS_TEMPLATE=Echo code: {code}

TELEGRAM_GATEWAY_TOKEN=

SMSC_LOGIN=
SMSC_PASSWORD=
# Alphanumeric sender name registered with the operators. Without one the
# operators either substitute a shared shortcode or reject the message.
SMSC_SENDER=

# --- Test accounts -----------------------------------------------------------
# Phones that sign in with AUTH_TEST_CODE and never send a message. These stay
# on in production by design: App Store and Play reviewers cannot receive an SMS
# on our numbers, and end-to-end tests need a login they can drive.
#
# Know what you are accepting: the numbers are guessable and the code is public,
# so these accounts are reachable by anyone who tries them. Never set a password
# on one, and keep nothing private in them.
#
# AUTH_TEST_ENABLED=false is the off switch. Blank AUTH_TEST_PHONES means the
# nine +7 defaults in services/auth-service/src/config.ts — clearing the list is
# NOT how you disable this, because compose cannot tell a cleared variable from
# an untouched one.
AUTH_TEST_ENABLED=true
AUTH_TEST_PHONES=
AUTH_TEST_CODE=000000

# --- Logging -----------------------------------------------------------------
# debug turns on the per-query and per-event lines; info is the normal setting.
LOG_LEVEL=info

# Relay for Telegram Gateway, whose IPv4 is unreachable from Russian hosting.
# See "Reaching Telegram Gateway" in README.md. Leave unset where the direct
# address works.
TELEGRAM_GATEWAY_BASE_URL=https://gatewayapi.telegram.org:8443

# --- Push notifications (APNs) -----------------------------------------------
# Leave all of these blank until the iOS app can obtain a device token. The push
# service starts either way: with no credentials it registers devices and logs
# what it would have sent, which is the correct state before the app ships.
#
# From the Apple Developer portal (see echo-client/PUSH_NOTIFICATIONS.md):
#   - enable Push Notifications on the App ID
#   - Keys -> create a key with APNs -> download the .p8 (ONCE, it is not
#     downloadable again) -> note its Key ID
#   - Team ID is top-right of the portal
#
# Put the .p8 in deploy/apns/ on the server (gitignored, mounted read-only at
# /run/secrets/apns) and point APNS_KEY_PATH at it *inside the container*:
#   scp AuthKey_ABCD123456.p8 root@<server>:/root/echo/echo-server/deploy/apns/
#
# Anyone holding this key can send notifications to every install of the app.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.evgenij.echo

# Whether a banner may quote the message it announces. Off by default: messages
# are encrypted at rest, and a preview hands their plaintext to Apple and to
# anyone reading the lock screen. A product decision, not a technical one.
PUSH_MESSAGE_PREVIEW=false
