# Copy to deploy/.env on the server and fill in. Never commit the filled copy —
# it holds every secret the stack has.
#
# Generate the random values with:
#   JWT_SECRET / INTERNAL_API_KEY / POSTGRES_PASSWORD / LIVEKIT_API_SECRET
#     openssl rand -base64 36
#   MESSAGE_ENCRYPTION_KEY (must be exactly 32 bytes, base64)
#     openssl rand -base64 32

# --- Domains -----------------------------------------------------------------
# Each needs an A record pointing at this server before the first `up`, or
# Caddy's certificate request fails.
# app: the web client, served by Caddy from ./client-dist (see README).
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
WS_DOMAIN=ws.example.com
LIVE_DOMAIN=live.example.com
ACME_EMAIL=you@example.com

# Exact origins the web client is served from, comma-separated. No wildcards:
# these are sent credentials.
ALLOWED_ORIGINS=https://app.example.com

# --- Secrets -----------------------------------------------------------------
JWT_SECRET=
INTERNAL_API_KEY=
POSTGRES_USER=echo
POSTGRES_PASSWORD=

# At-rest message encryption for pers-chats-service. Losing this key means
# losing every stored message — back it up off this server. Either "<base64>"
# (implicit key_id 1) or "1:<b64>,2:<b64>" for rotation.
MESSAGE_ENCRYPTION_KEY=

# --- LiveKit (voice) ---------------------------------------------------------
LIVEKIT_API_KEY=echo
LIVEKIT_API_SECRET=

# --- Object storage: Yandex Object Storage -----------------------------------
# Create the bucket and a service account with storage.editor first; the key
# pair below is that account's static access key. The service does not create
# the bucket in production — it has no right to.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=echo-blobs
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Yandex serves virtual-host style; path-style is a MinIO-only requirement.
S3_FORCE_PATH_STYLE=false

# --- SMS ---------------------------------------------------------------------
# log      — writes sign-in codes to the service log (start here, then move off)
# telegram — Telegram Gateway; cheap, no sender registration, Telegram users only
# smsc     — SMSC.ru; reaches everyone, needs a contract and a registered sender
#
# The intended production pairing is telegram with smsc as the fallback.
SMS_DRIVER=log
SMS_FALLBACK_DRIVER=
SMS_TEMPLATE=Echo code: {code}

TELEGRAM_GATEWAY_TOKEN=

SMSC_LOGIN=
SMSC_PASSWORD=
# Alphanumeric sender name registered with the operators. Without one the
# operators either substitute a shared shortcode or reject the message.
SMSC_SENDER=

# --- Logging -----------------------------------------------------------------
# debug turns on the per-query and per-event lines; info is the normal setting.
LOG_LEVEL=info
