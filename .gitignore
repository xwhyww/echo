node_modules

# Output — unanchored, because the client that produces them lives one level
# down in echo-client/ rather than at the repo root.
.output
.vercel
.netlify
.wrangler
.svelte-kit
build
dist

# The built client, uploaded to the server and served by Caddy from there. The
# directory itself stays tracked so the bind mount in docker-compose.prod.yml
# has something to attach to on a fresh clone.
echo-server/deploy/client-dist/*
!echo-server/deploy/client-dist/.gitkeep

# Tauri — the Rust build directory, several gigabytes of it.
src-tauri/target

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.prod.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Editors — .vscode is shared on purpose; the JetBrains folder is per-machine.
.idea

# Local Claude Code settings (the shared ones live in .claude/settings.json)
.claude/settings.local.json

# Emoji assets — 32 MB copied out of node_modules/emoji-datasource-apple by
# echo-client's postinstall (scripts/copy-emoji-assets.mjs). Reproducible, so
# the lockfile is the source of truth rather than these 3794 files.
echo-client/static/emojis/apple/

# Scratch
package.json.tmp
