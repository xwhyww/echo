<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Merged into the generated iOS Info.plist by Tauri (it picks up Info.plist and
	Info.ios.plist sitting next to tauri.conf.json). iOS-only keys live here so
	the macOS bundle doesn't inherit them.
-->
<plist version="1.0">
<dict>
	<!-- The app is dark-only (see `color-scheme: dark` in reset.css), and without
	     this the *system* half of it follows the phone instead. That shows up
	     first as a white flash at launch: LaunchScreen.storyboard paints
	     `systemBackgroundColor`, which resolves to white on a phone in light
	     mode, before the webview has drawn anything. Pinning the style also keeps
	     the keyboard, share sheets and system alerts dark. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<!-- iOS kills the process rather than showing a permission prompt if the
	     matching usage string is missing. The mic one is not optional: every
	     voice channel and call goes through getUserMedia. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Echo uses the microphone for voice channels and calls.</string>
	<key>NSCameraUsageDescription</key>
	<string>Echo uses the camera for video calls.</string>

	<!-- Reaching echo-server on a LAN address trips iOS 14+ local network
	     privacy, which is a separate prompt from the ones above. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Echo connects to the Echo server running on your local network.</string>

	<!-- DEV ONLY. App Transport Security blocks cleartext HTTP, and the client
	     talks to http://host:3000 and ws://host:3004. NSAllowsLocalNetworking
	     opens exactly that hole for LAN addresses and nothing else — it is the
	     narrow form Apple tolerates, unlike NSAllowsArbitraryLoads. Delete this
	     block once echo-server is behind TLS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Without this the audio session is torn down when the screen locks and
	     an in-progress call goes silent. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- Screen sharing. iOS has no getDisplayMedia, so the screen is captured by
	     the ReplayKit broadcast extension and handed to the app over a socket in
	     the shared App Group container; a native LiveKit connection publishes it.
	     These two keys are how the LiveKit SDK finds both ends — without them it
	     looks for `group.<bundle-id>` and `<bundle-id>.broadcast` by convention,
	     which happens to be what we use, but naming them is what makes the
	     coupling visible from here. See src-tauri/ios/. -->
	<key>RTCAppGroupIdentifier</key>
	<string>group.com.evgenij.echo</string>
	<key>RTCScreenSharingExtension</key>
	<string>com.evgenij.echo.broadcast</string>
</dict>
</plist>
