<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The main app's half of the App Group shared with the broadcast extension.
	See BroadcastExtension/Broadcast.entitlements — the two must agree.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.evgenij.echo</string>
	</array>
</dict>
</plist>
