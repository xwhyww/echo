# Copy to .env (gitignored) and fill in. The ios:* scripts load this file via
# scripts/with-env.sh; vite picks up the VITE_* names on its own.

# Which machine runs echo-server (host only — ports 3000/3004 are fixed).
#
# Leave unset for the browser, `npm run desktop`, and `npm run ios:dev`:
# all three can work the host out from the URL they were served over.
#
# Set it for a bundled mobile build (`npm run ios:build`), where the frontend
# ships on disk and `localhost` would mean the phone itself:
#
#   VITE_API_HOST=192.168.1.5
VITE_API_HOST=

# Apple Developer team, required for any iOS build because code signing is
# enforced. Find it in the OU field of your signing certificate:
#
#   security find-certificate -a -c "Apple Development" -p |
#     openssl x509 -noout -subject
#
# It is per-developer, which is why it lives here rather than in
# tauri.conf.json — src-tauri/gen/ is gitignored for the same reason.
APPLE_DEVELOPMENT_TEAM=
