# Backend endpoints. Leave both unset for local development: the client then
# follows the host that served the page (see API_HOST in src/lib/api/client.ts),
# which is what makes opening the dev server from a phone on the same wifi work.
#
# Set them for a deployed build — copy to .env and fill in your domain. Vite
# inlines these at build time, so a change means a rebuild, and for the Tauri
# desktop build they must be set before `tauri build`.
# VITE_API_URL=https://api.example.com
# VITE_WS_URL=wss://ws.example.com/ws
